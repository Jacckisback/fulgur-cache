#: assets/admin.js:35
msgid "Cache"
msgstr "Cache"

#: assets/admin.js:36
msgid "Page cache"
msgstr "Cache de page"

#: assets/admin.js:37
msgid "Enable page cache"
msgstr "Activer le cache de page"

#: assets/admin.js:37
msgid "Each page is generated once, then served as static HTML, without PHP or database. This is the setting that brings the most speed."
msgstr "Chaque page est générée une seule fois puis servie en HTML statique, sans PHP ni base de données. C'est le réglage qui apporte le plus de vitesse."

#: assets/admin.js:38
msgid "Cache lifespan"
msgstr "Durée de vie du cache"

#: assets/admin.js:38
msgid "hours"
msgstr "heures"

#: assets/admin.js:38
msgid "Pages are regenerated after this delay. 0 = never (automatic purging is enough in 99% of cases)."
msgstr "Les pages sont régénérées après ce délai. 0 = jamais (la purge automatique suffit dans 99 % des cas)."

#: assets/admin.js:39
msgid "Compression and browser cache"
msgstr "Compression et cache navigateur"

#: assets/admin.js:39
msgid "Brotli/gzip + one-year caching of images, CSS, JS and fonts in the visitor's browser."
msgstr "Brotli/gzip + mise en cache d'un an des images, CSS, JS et polices dans le navigateur du visiteur."

#: assets/admin.js:40
msgid "Separate mobile cache"
msgstr "Cache séparé pour mobile"

#: assets/admin.js:40
msgid "Only if your theme generates different HTML on mobile (rare). Leave off for a responsive theme."
msgstr "Uniquement si ton thème génère un HTML différent sur mobile (rare). Laisse désactivé pour un thème responsive."

#: assets/admin.js:41
msgid "Cache 404 pages"
msgstr "Mettre en cache les pages 404"

#: assets/admin.js:41
msgid "Protects the server against bots probing non-existent URLs."
msgstr "Protège le serveur contre les robots qui testent des URL inexistantes."

#: assets/admin.js:43
msgid "Exclusions"
msgstr "Exclusions"

#: assets/admin.js:44
msgid "URLs never cached"
msgstr "URL jamais mises en cache"

#: assets/admin.js:44
msgid "One per line. Accepts part of a URL (/cart/), a wildcard (/account/*) or a regex (#^/private#)."
msgstr "Une par ligne. Accepte une partie d'URL (/panier/), un joker (/compte/*) ou une regex (#^/prive#)."

#: assets/admin.js:45
msgid "Ignored URL parameters"
msgstr "Paramètres d'URL ignorés"

#: assets/admin.js:45
msgid "Campaign links (utm_source, fbclid…) get the same cached page instead of regenerating it."
msgstr "Les liens de campagne (utm_source, fbclid…) servent la même page en cache au lieu de la régénérer."

#: assets/admin.js:46
msgid "Cookies that disable the cache"
msgstr "Cookies qui désactivent le cache"

#: assets/admin.js:46
msgid "One name (or name prefix) per line. Login and WooCommerce cart cookies are already handled."
msgstr "Un nom (ou début de nom) par ligne. Les cookies de connexion et de panier WooCommerce sont déjà gérés."

#: assets/admin.js:47
msgid "Excluded browsers / bots"
msgstr "Navigateurs / robots exclus"

#: assets/admin.js:47
msgid "Part of the User-Agent, one per line."
msgstr "Une partie du User-Agent par ligne."

#: assets/admin.js:50
msgid "CSS & JavaScript"
msgstr "CSS & JavaScript"

#: assets/admin.js:51
msgid "HTML & CSS"
msgstr "HTML & CSS"

#: assets/admin.js:52
msgid "Minify HTML"
msgstr "Minifier le HTML"

#: assets/admin.js:52
msgid "Removes comments and useless whitespace."
msgstr "Supprime commentaires et espaces inutiles."

#: assets/admin.js:53
msgid "Minify CSS"
msgstr "Minifier le CSS"

#: assets/admin.js:53
msgid "Lighter CSS files, cached for one year."
msgstr "Fichiers CSS allégés et mis en cache d'un an."

#: assets/admin.js:54
msgid "Visible text while fonts load"
msgstr "Texte visible pendant le chargement des polices"

#: assets/admin.js:54
msgid "Adds font-display: swap: text shows immediately with a system font."
msgstr "Ajoute font-display: swap : le texte s'affiche immédiatement avec une police système."

#: assets/admin.js:55
msgid "Critical CSS / unused CSS"
msgstr "CSS critique / CSS inutilisé"

#: assets/admin.js:55
msgid "Critical CSS: used CSS inlined, the rest loaded async (recommended)"
msgstr "CSS critique : CSS utile en ligne, le reste en asynchrone (recommandé)"

#: assets/admin.js:55
msgid "Remove unused CSS: the rest is only loaded on first interaction"
msgstr "Supprimer le CSS inutilisé : le reste n'est chargé qu'à la première interaction"

#: assets/admin.js:55
msgid "Each page only gets the CSS rules it uses, right in the HTML: no CSS blocks rendering anymore. Computed on your server, no external service."
msgstr "Chaque page reçoit uniquement les règles CSS qu'elle utilise, directement dans le HTML : plus aucun CSS ne bloque l'affichage. Calculé sur ton serveur, sans service externe."

#: assets/admin.js:56
msgid "CSS classes always kept"
msgstr "Classes CSS toujours conservées"

#: assets/admin.js:56
msgid "Classes added by JavaScript (open menus, sliders, pop-ups). Part of a name, one per line."
msgstr "Classes ajoutées par JavaScript (menus ouverts, sliders, pop-ups). Une partie de nom par ligne."

#: assets/admin.js:57
msgid "Google Fonts"
msgstr "Google Fonts"

#: assets/admin.js:57
msgid "Leave unchanged"
msgstr "Ne rien changer"

#: assets/admin.js:57
msgid "Optimize (swap + preconnect)"
msgstr "Optimiser (swap + préconnexion)"

#: assets/admin.js:57
msgid "Host locally (GDPR + faster)"
msgstr "Héberger localement (RGPD + plus rapide)"

#: assets/admin.js:57
msgid "Local hosting removes the connection to Google: faster and GDPR-compliant."
msgstr "L'hébergement local supprime la connexion à Google : plus rapide et conforme RGPD."

#: assets/admin.js:59
msgid "JavaScript"
msgstr "JavaScript"

#: assets/admin.js:60
msgid "Defer JavaScript"
msgstr "Reporter le JavaScript (defer)"

#: assets/admin.js:60
msgid "Scripts run after the page is displayed, in their original order."
msgstr "Les scripts s'exécutent après l'affichage de la page, dans leur ordre d'origine."

#: assets/admin.js:61
msgid "Scripts not to defer"
msgstr "Scripts à ne pas reporter"

#: assets/admin.js:61
msgid "Part of a URL or code, one per line."
msgstr "Une partie d'URL ou de code par ligne."

#: assets/admin.js:62
msgid "Load JavaScript on first interaction"
msgstr "Charger le JavaScript à la première interaction"

#: assets/admin.js:62
msgid "The most spectacular PageSpeed gain: no script runs until the visitor moves the mouse, touches the screen or scrolls. Test your site after enabling it."
msgstr "Le gain le plus spectaculaire sur PageSpeed : aucun script ne s'exécute avant que le visiteur bouge la souris, touche l'écran ou fasse défiler. Teste ton site après activation."

#: assets/admin.js:63
msgid "Force loading after"
msgstr "Chargement forcé après"

#: assets/admin.js:63
msgid "seconds"
msgstr "secondes"

#: assets/admin.js:63
msgid "0 = on interaction only. Use 5 to 10 s if you have analytics scripts."
msgstr "0 = uniquement à l'interaction. Mets 5 à 10 s si tu as des scripts de statistiques."

#: assets/admin.js:64
msgid "Scripts to load immediately"
msgstr "Scripts à charger immédiatement"

#: assets/admin.js:64
msgid "Part of a URL or code, one per line (e.g. cookie banner, slider at the top of the page)."
msgstr "Une partie d'URL ou de code par ligne (ex. : bandeau cookies, slider en haut de page)."

#: assets/admin.js:67
msgid "Media"
msgstr "Médias"

#: assets/admin.js:68
msgid "Image loading"
